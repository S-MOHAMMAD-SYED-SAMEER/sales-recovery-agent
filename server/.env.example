# Which LLM provider /api/chat uses: "gemini", "anthropic", or "demo".
# Gemini is the free-tier dev default while the Anthropic account has no
# prepaid credits. Switch back to "anthropic" once credits are added — no
# code change needed, both adapters stay implemented.
# "demo" is a deterministic, credential-free stand-in for a portfolio demo —
# no GEMINI_API_KEY or ANTHROPIC_API_KEY needed. See
# server/src/llm/providers/demo.js for exactly what it can answer.
LLM_PROVIDER=gemini

# Gemini API key (Google AI Studio: https://aistudio.google.com/apikey).
# Required when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Stable, free-tier-eligible Gemini model. Do not change to a paid-only or
# preview model without approval.
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude API key (Anthropic Console). Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Port the Express server listens on. Optional, defaults to 3000.
PORT=3000

# Path to the local SQLite conversation-memory database file. Optional —
# defaults to sales-recovery-agent/server/data/memory.sqlite. Use ":memory:"
# for a throwaway in-memory database (tests use this automatically).
SQLITE_PATH=

# Local Chroma server connection (RAG knowledge base). Optional — these are
# already the defaults. Requires `chroma run --path ./data/chroma --port 8000`
# running locally; see README "Local development" for setup. No API key
# needed, Chroma and the embedding model are both fully local.
CHROMA_HOST=
CHROMA_PORT=
CHROMA_COLLECTION=

# Reach Chroma over HTTPS instead of HTTP. Optional, defaults to false —
# leave it empty for local development. Set to "true" only when pointing at a
# hosted Chroma behind TLS (the deployed Render service), in which case
# CHROMA_PORT must be 443. See DEPLOYMENT.md for the exact deployed values.
CHROMA_SSL=

# Directory containing the knowledge-base source markdown files. Optional —
# defaults to sales-recovery-agent/server/data/kb.
KB_DIR=

# In-process rate limit for POST /api/chat only (never /api/health), keyed
# by client IP. Both optional — these are already the defaults. See
# server/src/middleware/rateLimiter.js.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
